# Template for local configuration.
# Copy this file to .env and fill values locally. Never paste secrets into chat.

# Shopify app and dev store must belong to the same organization when using
# the client-credentials grant. Install the app on that store first.
# SHOPIFY_SHOP is the subdomain only: example-store, without .myshopify.com.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# The store's currency code (Shopify admin → Settings → Store details). Sync checks it.
SHOP_CURRENCY=PKR

# The backend must obtain/cache an access token and renew it before expiry.
# Credentials stay server-side; never prefix them with NEXT_PUBLIC_.

# Local MySQL + Redis via `docker compose up -d`. Pick any local passwords;
# the password inside DATABASE_URL must equal MYSQL_PASSWORD.
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DATABASE_URL="mysql://app:replace-with-local-password@127.0.0.1:3306/hubex_marketplace"
REDIS_URL="redis://127.0.0.1:6379"

# Optional: trace|debug|info|warn|error (default info)
LOG_LEVEL=info
