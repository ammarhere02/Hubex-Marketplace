// Data model — see docs/design.md for ownership and flows.
// Shopify owns the catalog (we keep a synced copy); MySQL owns orders and job history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING_SYNC
  SYNCED
  FAILED
}

enum JobStatus {
  STARTED
  COMPLETED
  FAILED
}

// ---------- Catalog (copied from Shopify by the sync-products job) ----------

model Product {
  id              Int           @id @default(autoincrement())
  shopifyId       String        @unique @db.VarChar(64)
  handle          String        @db.VarChar(255)
  title           String        @db.VarChar(255)
  descriptionHtml String        @db.Text
  status          ProductStatus
  // Shopify productType; the storefront uses it as the category ("" = uncategorised).
  productType     String        @default("") @db.VarChar(255)
  options         Json
  // Set when a completed scan no longer sees this product in Shopify (deleted).
  isRemoved       Boolean       @default(false)
  lastSyncedAt    DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  variants        ProductVariant[]
  images          ProductImage[]
  webhookReceipts WebhookReceipt[]

  @@index([status, isRemoved])
  @@index([productType])
}

model ProductVariant {
  id                Int      @id @default(autoincrement())
  shopifyId         String   @unique @db.VarChar(64)
  productId         Int
  title             String   @db.VarChar(255)
  sku               String?  @db.VarChar(255)
  price             Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  inventoryQuantity Int
  availableForSale  Boolean
  selectedOptions   Json
  // Shopify media ID of the variant's own image (matches ProductImage.shopifyId), if any.
  imageShopifyId    String?  @db.VarChar(64)
  isRemoved         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  shopifyId String   @unique @db.VarChar(64)
  productId Int
  url       String   @db.VarChar(1024)
  altText   String?  @db.VarChar(512)
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, position])
}

// ---------- Orders (owned locally; submitted to Shopify by the worker) ----------

model Order {
  id               Int         @id @default(autoincrement())
  // Random, unguessable ID used in the confirmation URL instead of the sequential id.
  publicId         String      @unique @db.VarChar(36)
  status           OrderStatus @default(PENDING_SYNC)
  customerName     String      @db.VarChar(255)
  phone            String      @db.VarChar(32)
  address1         String      @db.VarChar(255)
  address2         String?     @db.VarChar(255)
  city             String      @db.VarChar(128)
  province         String?     @db.VarChar(128)
  zip              String      @db.VarChar(32)
  country          String      @db.VarChar(64)
  email            String?     @db.VarChar(255)
  subtotal         Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  currency         String      @db.VarChar(3)
  paymentMethod    String      @default("COD") @db.VarChar(16)
  shopifyOrderId   String?     @unique @db.VarChar(64)
  shopifyOrderName String?     @db.VarChar(32)
  // Incremented in MySQL at the start of every submit attempt (limit: 5).
  attempts         Int         @default(0)
  lastError        String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  submittedAt      DateTime?
  syncedAt         DateTime?

  items OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id               Int     @id @default(autoincrement())
  orderId          Int
  variantId        Int
  // Snapshots taken at checkout; never re-read from the catalog afterwards.
  shopifyVariantId String  @db.VarChar(64)
  productTitle     String  @db.VarChar(255)
  variantTitle     String  @db.VarChar(255)
  sku              String? @db.VarChar(255)
  unitPrice        Decimal @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

// ---------- Job history (one row per execution attempt) ----------

model JobLog {
  id         Int       @id @default(autoincrement())
  queueName  String    @db.VarChar(64)
  jobName    String    @db.VarChar(64)
  jobId      String    @db.VarChar(128)
  attempt    Int
  status     JobStatus
  entityId   String?   @db.VarChar(64)
  startedAt  DateTime
  finishedAt DateTime?
  durationMs Int?
  error      String?   @db.Text
  willRetry  Boolean   @default(false)

  @@index([jobName, startedAt])
  @@index([jobId])
}

enum WebhookReceiptStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// One row per Shopify webhook delivery. eventId is unique, so a re-delivered webhook
// is rejected by MySQL instead of being processed twice. productId stays null until
// the worker has synced the product (products/create arrives before the row exists).
model WebhookReceipt {
  id               Int                  @id @default(autoincrement())
  eventId          String               @unique @db.VarChar(128)
  topic            String               @db.VarChar(64)
  shopifyProductId String               @db.VarChar(64)
  productId        Int?
  product          Product?             @relation(fields: [productId], references: [id])
  status           WebhookReceiptStatus @default(RECEIVED)
  triggeredAt      DateTime?
  receivedAt       DateTime             @default(now())
  processedAt      DateTime?
  error            String?              @db.Text

  @@index([shopifyProductId, receivedAt])
  @@index([status, receivedAt])
}

// ---------- Auth (Passport local strategy; sessions are DB-backed tokens) ----------

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
}

// Opaque session tokens: the cookie holds the raw token, MySQL stores its SHA-256
// hash, so a DB leak can't be replayed as a login. Expired rows are ignored on read.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(64)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
